# Copy to .env for local development. Replace SECRET_KEY with a generated value.
DEBUG=True
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# When DEBUG=False, Django requires these production PostgreSQL settings.
# Supply production values through your deployment platform, not a local file.
# DEBUG=False
# SECRET_KEY=
# ALLOWED_HOSTS=example.com,www.example.com
# CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
# DB_NAME=kamikon
# DB_USER=kamikon
# DB_PASSWORD=
# DB_HOST=db.example.internal
# DB_PORT=5432
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# Enable only if every subdomain uses HTTPS and the domain is ready for HSTS preload.
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
